# Scenario S2's injected failure, loaded only through
# deploy/test/dropins-migration-failure/. It is loaded after secrets.env, so
# this DATABASE_URL is the one migrate uses.
#
# Port 1 on loopback: nothing listens there, so the connection is refused
# immediately and the unit fails fast rather than sitting in a connect timeout.
# An unreachable server rather than a syntactically broken URL, so the failure
# is the one D-005 is about -- migrations did not apply -- and not an argument
# parse error that never touches a database.
DATABASE_URL=postgres://hirame:hirame-e2e-not-a-secret@127.0.0.1:1/hirame?sslmode=disable
