# Test-profile credentials, installed as ~/.config/hirame/secrets.env by
# run-e2e.sh.
#
# THESE ARE NOT SECRETS AND ARE COMMITTED ON PURPOSE. They authenticate a
# throwaway PostgreSQL and a throwaway S3 gateway that exist only for the
# length of one `run-e2e.sh`, both on a loopback address inside a private
# namespace. deploy/config/secrets.env.template stays the template a real
# deployment fills in; nothing here may ever be copied into one.
#
# Same two changes as hirame.env: hosts are 127.0.0.1 because the test profile
# runs with --network=host.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=hirame
POSTGRES_USER=hirame
POSTGRES_PASSWORD=hirame-e2e-not-a-secret

DATABASE_URL=postgres://hirame:hirame-e2e-not-a-secret@127.0.0.1:5432/hirame?sslmode=disable
DATABASE_MAX_CONNS=10

# --- VersityGW --------------------------------------------------------------
ROOT_ACCESS_KEY_ID=hirame-e2e-access-key
ROOT_SECRET_ACCESS_KEY=hirame-e2e-secret-key

S3_ACCESS_KEY_ID=hirame-e2e-access-key
S3_SECRET_ACCESS_KEY=hirame-e2e-secret-key

MC_HOST_gw=http://hirame-e2e-access-key:hirame-e2e-secret-key@127.0.0.1:7070
