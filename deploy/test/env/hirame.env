# Test-profile process configuration, installed as ~/.config/hirame/hirame.env
# by run-e2e.sh. It is deploy/config/hirame.env.template with exactly two kinds
# of change, both forced by the harness rather than chosen:
#
#   * every service host is 127.0.0.1, because the test profile runs every
#     container with --network=host (no iptables => no netavark => no bridge,
#     and therefore no container-name DNS);
#   * the timers are shortened so a scenario does not spend minutes waiting.
#
# LISTEN_ADDR is deliberately NOT changed: apps/web-gui/Caddyfile hard-codes
# reverse_proxy 127.0.0.1:8081, and host networking makes that reach the API
# for the same reason the pod's shared netns does in the real deployment. The
# deployed Caddyfile is therefore under test unmodified.

# --- search-api -------------------------------------------------------------

LISTEN_ADDR=127.0.0.1:8081
SHUTDOWN_TIMEOUT=30s
READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=30s
IDLE_TIMEOUT=120s

# --- dependencies -----------------------------------------------------------

TIKA_URL=http://127.0.0.1:9998
TIKA_TIMEOUT=5m
TIKA_MAX_BYTES=536870912
TIKA_MAX_RESPONSE_BYTES=67108864

GAHAKU_URL=127.0.0.1:9000
GAHAKU_TIMEOUT=5m

S3_ENDPOINT=http://127.0.0.1:7070
S3_REGION=us-east-1
S3_BUCKET=hirame-thumbnails
S3_USE_PATH_STYLE=true

S3_MAX_CACHE_BYTES=8589934592
S3_MAX_OBJECT_AGE=720h
# 15m in the deployment. Short enough that a scenario can watch one eviction
# pass run, long enough that it does not fire under every other scenario.
S3_EVICTION_INTERVAL=2m
# 6h in the deployment. Short enough that a scenario can watch the backstop
# withdraw stale accounting and collect an orphaned object.
S3_SWEEP_INTERVAL=2m
S3_TIMEOUT=30s

# --- indexer ----------------------------------------------------------------

WATCH_MOUNTPOINTS=/srv/documents
WATCH_DEBOUNCE_INTERVAL=1s

# Identical to deploy/config/hirame.env.template — repeated only because this
# file is a whole environment, not an overlay on it.
OVERWATCH_SOCKET=/run/overwatch/hirame/hirame.sock
# 5s in the deployment. The fake daemon reports a STREAM_START gap on every
# subscription, so this interval is also how often a full rescan happens, which
# is what re-ingests a modified file in scenario S5.
WATCH_RECONNECT_BACKOFF=3s

RIVER_WORKERS=4
EXTRACT_CONCURRENCY=4
RENDER_CONCURRENCY=2
THUMBNAIL_CONCURRENCY=4
