# Scenario S8's quota half, loaded only through dropins-eviction-quota/.
#
# A one-byte cache-wide quota, so the very first stored thumbnail is already
# over it and the maintenance job's quota pass has something to do without the
# scenario having to render megabytes.
#
# An extra EnvironmentFile= rather than an Environment= drop-in, matching S2:
# EnvironmentFile= is a list key, so this one is appended and podman applies
# --env-file in order. An Environment= drop-in would work too, but its
# precedence against the unit's two --env-file arguments is podman's merge rule
# rather than anything this file can show, and file order is the mechanism the
# rest of the harness already relies on.
S3_MAX_CACHE_BYTES=1
