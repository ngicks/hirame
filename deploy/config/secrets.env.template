# Every credential the deployment needs, in one file, with placeholders only.
# Nothing here may be committed with a real value.
#
# Install as ~/.config/hirame/secrets.env, mode 0600 — the units load it with a
# plain EnvironmentFile= and no `-` prefix, so a missing file fails the unit
# rather than starting a service with no credentials:
#
#	mkdir -p ~/.config/hirame
#	umask 077
#	sed -e "s/__DB_PASSWORD__/$(openssl rand -hex 24)/g" \
#	    -e "s/__S3_ACCESS_KEY__/$(openssl rand -hex 16)/g" \
#	    -e "s/__S3_SECRET_KEY__/$(openssl rand -hex 32)/g" \
#	    deploy/config/secrets.env.template > ~/.config/hirame/secrets.env
#
# Rotating any of these means restarting the units that read them; none is
# re-read at runtime. The database password additionally has to be changed in
# PostgreSQL itself — POSTGRES_PASSWORD only applies at first initialisation.
#
# One file for the whole deployment, not one per service: every unit that needs
# any credential loads all of them, so PostgreSQL's container also holds the S3
# keys and vice versa. The trade is deliberate — the alternative is four files
# whose overlapping values (the same S3 pair appears under three names below)
# drift apart, and every process here already sits on the same trusted internal
# network. Split it if that stops being true.

# --- PostgreSQL -------------------------------------------------------------
# Read by postgres.container. POSTGRES_PASSWORD is consumed by the image's
# entrypoint on the first start only; afterwards the role owns it.
POSTGRES_DB=hirame
POSTGRES_USER=hirame
POSTGRES_PASSWORD=__DB_PASSWORD__

# Read by migrate, search-api, and indexer. It repeats the credentials above
# because config.Database.URL is a full DSN; keep the two in step. sslmode is
# disable because the connection never leaves the internal podman network
# (D-010) and PostgreSQL here holds no certificate.
DATABASE_URL=postgres://hirame:__DB_PASSWORD__@postgres:5432/hirame?sslmode=disable
DATABASE_MAX_CONNS=10

# --- VersityGW --------------------------------------------------------------
# The gateway's root credentials, under the names its binary reads.
ROOT_ACCESS_KEY_ID=__S3_ACCESS_KEY__
ROOT_SECRET_ACCESS_KEY=__S3_SECRET_KEY__

# The same pair under the names apps/search-api reads. Gahaku never sees them:
# it only ever receives urls the caller already signed.
S3_ACCESS_KEY_ID=__S3_ACCESS_KEY__
S3_SECRET_ACCESS_KEY=__S3_SECRET_KEY__

# And once more as an mc alias, which is how versitygw-bootstrap.container
# creates the thumbnail bucket without needing a shell to run `mc alias set`.
# Percent-encode any character the credentials carry that a url reserves.
MC_HOST_gw=http://__S3_ACCESS_KEY__:__S3_SECRET_KEY__@versitygw:7070
