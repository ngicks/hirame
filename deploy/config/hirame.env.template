# Non-secret process configuration shared by search-api, indexer, and migrate.
# The variable names and defaults are apps/search-api/internal/config/config.go;
# only the values this deployment must pin away from those defaults are listed.
#
# Install as ~/.config/hirame/hirame.env (mode 0644 is fine — nothing here is a
# credential). Everything with a password or key lives in secrets.env instead,
# which the same units load afterwards.
#
#	install -Dm0644 deploy/config/hirame.env.template ~/.config/hirame/hirame.env

# --- search-api -------------------------------------------------------------

# Loopback, not :8080: the API shares a pod network namespace with the Caddy
# proxy that fronts it (D-010), so binding anything wider would only widen the
# surface inside the pod. 8081 because Caddy holds 8080, the published port.
# Changing this means changing the reverse_proxy target in
# apps/web-gui/Caddyfile too.
LISTEN_ADDR=127.0.0.1:8081

SHUTDOWN_TIMEOUT=30s
READ_HEADER_TIMEOUT=10s

# --- dependencies on the internal network -----------------------------------
# Each host is a ContainerName= from deploy/quadlet/, resolved by the podman
# network's DNS. None of them is reachable from outside it.

TIKA_URL=http://tika:9998
TIKA_TIMEOUT=5m
# 512 MiB. Tika holds the document in the JVM heap while parsing, so an
# unbounded cap turns one pathological scan into an OOM for every extraction.
TIKA_MAX_BYTES=536870912

GAHAKU_URL=gahaku:9000
GAHAKU_TIMEOUT=5m

S3_ENDPOINT=http://versitygw:7070
# VersityGW's default region. A presign signed for any other region comes back
# as a 403 that reads like an expired url.
S3_REGION=us-east-1
S3_BUCKET=hirame-thumbnails
S3_USE_PATH_STYLE=true

# The cache-wide quota and per-object age enforced by the River maintenance job
# (D-008). 8 GiB and 30 days; 0 disables either limit.
S3_MAX_CACHE_BYTES=8589934592
S3_MAX_OBJECT_AGE=720h

# --- indexer ----------------------------------------------------------------

# The container path of the read-only bind mount in indexer.container and
# overwatch.container. Keep it identical in deploy/config/overwatch.json: the
# daemon reports the paths it watched, and the indexer resolves them in its own
# mount namespace.
WATCH_MOUNTPOINTS=/srv/documents
WATCH_DEBOUNCE_INTERVAL=2s

# 0 lets River size the pool from the CPU count.
RIVER_WORKERS=0
EXTRACT_CONCURRENCY=4
# Counted per process, and both binaries render: Gahaku's own worker queue is
# the shared bottleneck, so raise GAHAKU_WORKER_CONCURRENCY with it.
RENDER_CONCURRENCY=2

# The overwatch daemon's gRPC socket, in the volume overwatch.container
# publishes and indexer.container mounts. It must be set: config.Watch's default
# is /run/overwatch/default/default.sock, the path the daemon derives from its
# *default* instance name, and deploy/config/overwatch.json names this
# deployment "hirame" instead. The dial is lazy, so a wrong value here does not
# stop the indexer starting — it makes every watcher RPC fail behind the
# reconnect backoff, with nothing on the filesystem ever reaching the pipeline.
#
# OVERWATCH_TARGET overrides this and takes a gRPC target instead, for a daemon
# reachable over TCP rather than through a shared socket.
OVERWATCH_SOCKET=/run/overwatch/hirame/hirame.sock
WATCH_RECONNECT_BACKOFF=5s
