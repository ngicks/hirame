# The render service (D-008): thumbnails and full-size views, produced on
# demand over gRPC. Follows gahaku/deployment/quadlet/gahaku.container, less
# its PublishPort — nothing outside hirame.network may reach it (D-010).
#
# Deliberately not ordered after versitygw.service: gahaku holds no storage
# credentials and never contacts the gateway until a request hands it a
# presigned url, so a gateway that is still starting costs nothing here.

[Unit]
Description=gahaku document rendering gRPC service

[Container]
# Published nowhere. Build it from the submodule's own Dockerfile:
#
#	podman build --tag gahaku:latest gahaku
#
# The localhost/ prefix keeps a missing build a loud "image not known" rather
# than a pull attempt against docker.io.
Image=localhost/gahaku:latest

# The host GAHAKU_URL in hirame.env names, and the authority of the gRPC target
# search-api and the indexer dial.
ContainerName=gahaku
Network=hirame.network

# Configured through the environment rather than Exec= arguments: the binary
# layers defaults < file < environment < flags, and Environment= lines are what
# a systemd drop-in can override without rewriting the unit.
Environment=GAHAKU_LISTEN=:9000

# The input guards stay on, at their defaults.
#
# They would have to be relaxed for a presigned-url flow against versitygw:
# GAHAKU_INPUT_BLOCK_PRIVATE_ADDRESSES refuses exactly the RFC1918 addresses
# hirame.network hands out, and GAHAKU_INPUT_ALLOW_HTTP the plain-http scheme
# the gateway serves. Nothing uses that flow — search-api and the indexer stream
# document bytes to gahaku over gRPC and never hand it a url (see
# internal/gahakuclient, and objstore's PresignGet/PresignPut, which have no
# caller) — so turning the guards off bought nothing and left gahaku willing to
# fetch and upload to any url a caller named.
#
# Set both of these if PresignGet/PresignPut ever gain a caller; until then this
# unit is the record that they were removed on purpose.

# Has to outlive the slowest render: it is the deadline a worker subprocess is
# killed on, and office conversions pay soffice's startup. Kept at or under the
# GAHAKU_TIMEOUT the callers use, so the caller's deadline is the outer one.
Environment=GAHAKU_WORKER_TIMEOUT=2m

# Bounds concurrent soffice subprocesses. RENDER_CONCURRENCY in hirame.env is
# counted per calling process, and both search-api and the indexer render, so
# this is the limit that actually caps the machine.
Environment=GAHAKU_WORKER_CONCURRENCY=4

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
