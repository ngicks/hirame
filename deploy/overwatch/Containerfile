# The go-overwatch daemon, built from the submodule rather than pulled from a
# module proxy: go-overwatch is pre-release (v0, no tags this deployment could
# pin), and D-006 makes the submodule revision recorded in this repository's
# index the reproducible reference. Build with the submodule as the context:
#
#	podman build -f deploy/overwatch/Containerfile -t hirame-overwatch:latest go-overwatch
#
# Only the `overwatch` module is copied. The repository also holds `reconciler`,
# which drags in a PostgreSQL driver this deployment does not use — the indexer
# is this system's consumer of the event stream.

FROM docker.io/library/golang:1.26-bookworm AS build

WORKDIR /src

COPY overwatch/go.mod overwatch/go.sum ./
RUN go mod download

COPY overwatch/cmd ./cmd
COPY overwatch/internal ./internal
COPY overwatch/pkg ./pkg

RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/overwatch ./cmd/overwatch

FROM docker.io/library/debian:bookworm-slim

COPY --from=build /out/overwatch /usr/local/bin/overwatch

# Runs as root on purpose. fanotify filesystem marks need CAP_SYS_ADMIN, and
# the unix socket the daemon creates is mode 0660 owned by whoever runs it —
# indexer.container joins group 0 to reach it. See deploy/README.md for what
# rootless podman can and cannot grant here.
ENTRYPOINT ["overwatch"]
