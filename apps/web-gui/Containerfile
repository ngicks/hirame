# The GUI ships as a static bundle behind Caddy, which is also the deployment's
# only published surface (D-010): it serves the SPA and proxies the ConnectRPC
# API same-origin. Caddy over nginx because the SPA fallback and the reverse
# proxy are two directives here rather than a try_files/upstream block, and the
# alpine image carries the busybox wget the unit's HealthCmd needs.

FROM docker.io/library/node:24-bookworm-slim AS build

WORKDIR /src

# pnpm pinned explicitly: package.json carries no packageManager field, so
# corepack has no version to activate. 10.x is the major that reads this
# repository's lockfileVersion 9.0 and honours pnpm-workspace.yaml settings
# such as minimumReleaseAgeExclude.
RUN npm install --global pnpm@10.34.5

# The dependency graph first, so a source-only change reuses the install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src

# `pnpm build` is `tsc --noEmit && vite build`: a type error fails the image
# build rather than shipping a bundle nobody type-checked.
RUN pnpm build

FROM docker.io/library/caddy:2.10-alpine

# Baked in rather than mounted so the image is runnable on its own — the unit
# can still override it with a Volume= over /etc/caddy/Caddyfile.
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv

EXPOSE 8080
